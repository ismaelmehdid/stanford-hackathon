# Copy this file to .env.local and fill in real values. Never commit .env.local.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.

# Apify API token (Console > Settings > API & Integrations).
APIFY_TOKEN=
# OpenAI API key. Used for transcription, video analysis, comments and conclusions.
OPENAI_API_KEY=
# Optional model overrides.
# OPENAI_VISION_MODEL=gpt-5.5
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
# Video generation model for Part 2.
# SORA_MODEL=sora-2
